---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout description="Music I've done!">
  <section>
    <h1 class="page-title">music</h1>
    <div class="music-project">
      <h2>tfofb.</h2>
      <p>
        Once in a blue moon I make music under the name of Twisted Face of
        Fading Beauty, which 14-year-old me, obsessed with Post-Rock bands with
        long names thought was a great idea. Anyways, I promise the music is not
        half as bad as the name:
      </p>

      <iframe
        style="border: 0; width: 300px; height: 340px;"
        src="https://bandcamp.com/EmbeddedPlayer/album=4134533801/size=large/bgcol=ffffff/linkcol=63b2cc/artwork=small/transparent=true/"
        seamless
      ></iframe>

      <p>
        More in{" "}
        <a href="https://twistedfaceoffadingbeauty.bandcamp.com">Bandcamp</a>
      </p>
    </div>

    <div class="music-project">
      <h2>Last Farewell</h2>
      <p>
        I was also part of a band called Last Farewell back when I lived in
        Spain where we made some pretty cool blackgaze/post-hardcore music:
      </p>

      <iframe
        style="border: 0; width: 300px; height: 340px;"
        src="https://bandcamp.com/EmbeddedPlayer/album=277383641/size=large/bgcol=ffffff/linkcol=0687f5/artwork=small/transparent=true/"
        seamless
      ></iframe>
      <p>
        More in <a href="https://lastfarewell.bandcamp.com">Bandcamp</a>
      </p>
    </div>
  </section>

  <style>
    section {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding: 0;
      max-width: 52rem;
    }
    h1 {
      margin: 0;
    }

    div.music-project + div.music-project {
      margin-top: 1rem;
    }

    h2 {
      margin: 0;
    }

    p {
      margin: 0.5em 0;
    }

    div.music-project {
      border-top: 1px dashed var(--line-color);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem 0;
      width: 100%;
    }
    iframe {
      margin: 1rem 0;
    }
  </style>
</BaseLayout>
