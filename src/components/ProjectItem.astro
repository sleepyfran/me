---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
---

<div class={project.data.archived ? "project archived" : "project"}>
  <div class="header">
    <a
      href={
        project.data.useInternalPage
          ? `/projects/${project.id}/`
          : project.data.url
      }
    >
      <h4 class="title">[{project.data.name}]</h4>
    </a>
    {project.data.repoUrl && (
      <a href={project.data.repoUrl}>
        <h5 class="repo-link">[source code]</h5>
      </a>
    )}
  </div>
  <p>{project.data.description}</p>
  {project.data.techStack && <pre>{project.data.techStack.join(", ")}</pre>}
</div>

<style>
  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    width: 100%;
  }
  .project {
    height: 100%;
    padding: 1.2rem 0;
    border-top: 1px dashed var(--muted-color);
  }
  .archived {
    opacity: 0.7;
  }
  p,
  h4,
  h5 {
    margin: 0;
  }
  p {
    margin: 0.7rem 0;
  }
  pre {
    margin: 0;
    color: var(--muted-color);
    white-space: pre-wrap;
  }
  .repo-link {
    color: var(--pink-color);
  }
</style>
