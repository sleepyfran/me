---
const path = Astro.url.pathname;
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="sleepyfran home">
    <em>sleepyfran</em>
  </a>
  <div class="rule" aria-hidden="true"></div>
  <nav aria-label="Main navigation">
    <a
      class={
        path.startsWith("/projects") ? "terminal-link current" : "terminal-link"
      }
      href="/projects"
    >
      app/games
    </a>
    <a
      class={
        path.startsWith("/blog") ? "terminal-link current" : "terminal-link"
      }
      href="/blog"
    >
      blog
    </a>
    <a
      class={
        path.startsWith("/music") ? "terminal-link current" : "terminal-link"
      }
      href="/music"
    >
      music
    </a>
  </nav>
</header>

<style>
  .site-header {
    width: 100%;
    padding: 5.2rem 0 0;
  }
  .wordmark {
    display: inline-block;
    font-size: clamp(1.45rem, 3.4vw, 2.1rem);
    letter-spacing: -0.055em;
    color: var(--text-color);
  }
  .wordmark em {
    color: var(--accent-color);
    text-decoration: none;
    font-style: italic;
  }
  .wordmark:hover,
  .wordmark:focus-visible {
    background: transparent;
    color: var(--text-color);
  }
  .wordmark:hover em,
  .wordmark:focus-visible em {
    background: var(--accent-color);
    color: var(--bg-color);
  }
  .punctuation {
    letter-spacing: 0;
  }
  .rule {
    height: 1px;
    margin: 2rem 0 2rem;
    border-top: 2px dashed var(--line-color);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.35rem;
    align-items: center;
  }
  .current {
    color: var(--pink-color);
  }
  nav .terminal-link:hover,
  nav .terminal-link:focus-visible {
    color: var(--bg-color);
  }
  @media (max-width: 600px) {
    .site-header {
      padding-top: 2.6rem;
    }
    .rule {
      margin: 4rem 0 1.5rem;
    }
    nav {
      gap: 0.15rem 0.8rem;
    }
  }
</style>
