---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";

interface Props {
  description: string;
  showHeader?: boolean;
}

const { description, showHeader = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={description} />
  </head>
  <body>
    {showHeader && <Header />}

    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    width: min(80vw, 72rem);
    margin-inline: auto;
  }
  main {
    width: 100%;
    max-width: 72rem;
    padding-top: 2.5rem;
  }
  @media (max-width: 600px) {
    body {
      width: min(100% - 2rem, 72rem);
    }
    main {
      padding-top: 1.5rem;
    }
  }
</style>
